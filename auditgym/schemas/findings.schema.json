{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/findings.schema.json",
  "title": "findings",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "duplicate_invoice",
              "payment_allocation",
              "fx_rate",
              "period_cutoff"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "claimed_amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "episode_id",
    "findings"
  ],
  "additionalProperties": false
}
