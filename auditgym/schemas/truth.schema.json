{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/truth.schema.json",
  "title": "truth",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "issues": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "enum": [
              "duplicate_invoice",
              "payment_allocation",
              "fx_rate",
              "period_cutoff"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "expected_amount_minor": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "evidence_sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "scenario": {
            "enum": [
              "single",
              "fx_partial_boundary",
              "duplicate_fx"
            ]
          }
        },
        "required": [
          "issue_id",
          "type",
          "affected_ids",
          "expected_amount_minor",
          "currency",
          "evidence_sets",
          "scenario"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "episode_id",
    "issues"
  ],
  "additionalProperties": false
}
