{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/observation.schema.json",
  "title": "observation",
  "type": "object",
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "steps_remaining": {
      "type": "integer",
      "minimum": 0
    },
    "task": {
      "type": "string"
    },
    "manifest": {
      "$ref": "manifest.schema.json"
    },
    "policy": {
      "$ref": "policy.schema.json"
    },
    "tools": {
      "type": "object"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "step",
    "steps_remaining"
  ],
  "additionalProperties": false
}
